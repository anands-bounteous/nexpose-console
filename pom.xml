<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      nexpose-console : shared library module for the Nexpose Security Console.
      Contains domain models, custom exceptions, the report engine, the (mock)
      scan engine + engine pool, asset correlation, risk scoring, and auth.

      This artifact is a plain JAR (not an executable Spring Boot app). It must be
      installed to the local Maven repository FIRST:

          mvn clean install

      after which nexpose-root depends on it.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.rapid7.nexpose</groupId>
    <artifactId>nexpose-console</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>nexpose-console</name>
    <description>Shared modules and functionality for the Nexpose Security Console</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Spring context + SLF4J/Logback logging (shared beans live here). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Bean validation annotations used on domain/config objects. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              IMPORTANT: no spring-boot-maven-plugin repackage here. This is a
              library, so we want a plain reusable JAR, not an executable fat JAR.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
